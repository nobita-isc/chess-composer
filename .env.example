# ──────────────────────────────────────────────────────────────────────────────
# Database driver selection
# Values: sqlite (default, no external service required)
#         postgres (opt-in for production / higher concurrency)
# ──────────────────────────────────────────────────────────────────────────────
DATABASE_DRIVER=sqlite

# Path to SQLite database file.
# Defaults to packages/server/data/puzzles.db when left blank.
SQLITE_PATH=

# Postgres connection URL — required when DATABASE_DRIVER=postgres.
# Format: postgres://<user>:<password>@<host>:<port>/<dbname>
# Add ?sslmode=require for TLS in production.
# DATABASE_URL=postgres://chess_user:strongpassword@localhost:5432/chess_composer

# Maximum connections in the Postgres pool (optional, default 10).
# Tune based on your Postgres max_connections setting.
# PG_POOL_MAX=10
